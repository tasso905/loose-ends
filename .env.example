# Copy to .env.local and fill in. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Origin used in magic-link emails (set in production so the Host header cannot steer links).
SITE_URL=
# F1 Google identity sign-in: "true" only once Google OAuth credentials are configured in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=
# Server only. Used only by cron/daily, account deletion and inbound email.
SUPABASE_SERVICE_ROLE_KEY=

# AI (provider not chosen yet). AI_PROVIDER=fake uses recorded fixtures and makes no network calls.
AI_PROVIDER=
AI_MODEL=
# The chosen provider's API key goes here under the name its @ai-sdk package expects.
AI_API_KEY=

# Email (Resend)
RESEND_API_KEY=

# Cron
CRON_SECRET=

# Demo
DEMO_MODE=
DEMO_REPLAY=

# Spend cap
DAILY_AI_BUDGET_USD=

# Observability
SENTRY_DSN=
POSTHOG_KEY=
# Shows the analytics notice only together with POSTHOG_KEY and the shipped Settings toggle (D22).
ANALYTICS_ENABLED=
