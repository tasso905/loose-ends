# Copy to .env.local and fill in. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Origin used in magic-link emails (set in production so the Host header cannot steer links).
SITE_URL=
# F1 Google identity sign-in (D41): "true" shows Continue with Google. Set it only when the Supabase
# Google provider is on (locally: the three SUPABASE_AUTH_EXTERNAL_GOOGLE_* vars below).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=
# Server only. Used only by cron/daily, account deletion and inbound email.
SUPABASE_SERVICE_ROLE_KEY=

# Local Supabase Google provider. These go in supabase/.env (gitignored), not .env.local: the Supabase
# CLI reads them at `supabase start`. Leave unset to keep Google off (the default, and what CI uses).
# SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=true overrides `enabled = false` in supabase/config.toml.
SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# AI (D42): Google Gemini through @ai-sdk/google. Server only.
# AI_PROVIDER=google calls the Gemini API (live; free-tier data may be used by Google).
# AI_PROVIDER=fake replays recorded fixtures and makes no network calls (unit tests, E2E and CI use it).
AI_PROVIDER=google
# An exact model ID, never a moving "-latest" alias (refused), so eval results are reproducible.
AI_MODEL=gemini-3.5-flash
# Gemini API key. Passed to the Google provider explicitly; GOOGLE_GENERATIVE_AI_API_KEY is not read.
AI_API_KEY=

# Email (Resend)
RESEND_API_KEY=

# Cron
CRON_SECRET=

# Demo
DEMO_MODE=
DEMO_REPLAY=

# Spend cap
DAILY_AI_BUDGET_USD=

# Observability
SENTRY_DSN=
POSTHOG_KEY=
# Shows the analytics notice only together with POSTHOG_KEY and the shipped Settings toggle (D22).
ANALYTICS_ENABLED=
